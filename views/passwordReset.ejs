<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <link rel="stylesheet" href="/login.css">
</head>
<body>
    <div class="login-container">
        <div class="logo-placeholder"></div>
        <h1 class="login-title">Forgot Password</h1>
        <div id="msgBox"></div>
        <form id="forgotForm" class="login-form">
            <div class="form-group">
                <label for="email">Email address</label>
                <input type="email" id="email" name="email" required autocomplete="email">
                <span class="form-hint">Enter your account email to receive a password reset link.</span>
            </div>
            <button type="submit" class="btn-primary">Submit</button>
        </form>
    </div>
    <script>
        document.getElementById('forgotForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msgBox = document.getElementById('msgBox');
            msgBox.innerText = '';
            msgBox.className = '';
            msgBox.style.display = 'none';
            const email = document.getElementById('email').value.trim();
            try {
                const res = await fetch('/auth/forgotPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    msgBox.className = 'success-msg';
                    msgBox.innerText = 'Request submitted! Redirecting to password reset page...';
                    msgBox.style.display = 'block';
                    setTimeout(() => {
                        window.location.href = `/resetPassword/${encodeURIComponent(email)}`;
                    }, 1500);
                } else if (res.status === 400 || res.status === 404) {
                    msgBox.className = 'error-msg';
                    msgBox.innerText = data.message || 'Email address not found.';
                    msgBox.style.display = 'block';
                } else if (res.status >= 500) {
                    msgBox.className = 'error-msg';
                    msgBox.innerText = 'Server error (500), please try again later.';
                    msgBox.style.display = 'block';
                } else {
                    msgBox.className = 'error-msg';
                    msgBox.innerText = data.message || 'Request failed.';
                    msgBox.style.display = 'block';
                }
            } catch (err) {
                msgBox.className = 'error-msg';
                msgBox.innerText = 'System connection error, please try again later.';
                msgBox.style.display = 'block';
            }
        });
    </script>
</body>
</html>