<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <link rel="stylesheet" href="/login.css">
</head>
<body>
    <div class="login-container">
        <div class="logo-placeholder"></div>
        <h1 class="login-title">Set New Password</h1>
        <p class="form-hint" style="text-align: center; margin-bottom: 16px;">
            Resetting password for: <strong id="displayEmail" style="color: #1f2328;"></strong>
        </p>
        <div id="msgBox"></div>
        <form id="resetForm" class="login-form">
            <div class="form-group">
                <label for="newPassword">New Password</label>
                <input type="password" id="newPassword" name="newPassword" required autocomplete="new-password">
                <span class="form-hint">At least 8 characters, containing uppercase & lowercase letters, numbers, and special characters (!@#$%^&*_).</span>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password">
            </div>

            <button type="submit" class="btn-primary">Reset Password</button>
        </form>
    </div>

    <script>
        const pathSegments = window.location.pathname.split('/');
        const email = decodeURIComponent(pathSegments[pathSegments.length - 1]);
        if (!email) {
            alert('Invalid access. Please start from forgot password.');
            window.location.href = '/passwordReset';
        } else {
            document.getElementById('displayEmail').innerText = email;
        }
        document.getElementById('resetForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msgBox = document.getElementById('msgBox');
            msgBox.innerText = '';
            msgBox.className = '';
            msgBox.style.display = 'none';
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            if (newPassword !== confirmPassword) {
                msgBox.className = 'error-msg';
                msgBox.innerText = 'Passwords do not match!';
                msgBox.style.display = 'block';
                return;
            }
            try {
                const res = await fetch(`/auth/resetPassword/${encodeURIComponent(email)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newPassword, confirmPassword})
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    msgBox.className = 'success-msg';
                    msgBox.innerText = 'Password reset successful! Redirecting to login...';
                    msgBox.style.display = 'block';
                    document.getElementById('resetForm').reset();
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 1500);
                } else if (res.status === 400) {
                    msgBox.className = 'error-msg';
                    msgBox.innerText = data.message || 'Invalid password requirements or mismatch.';
                    msgBox.style.display = 'block';
                } else if (res.status >= 500) {
                    msgBox.className = 'error-msg';
                    msgBox.innerText = 'Server error (500), please try again later.';
                    msgBox.style.display = 'block';
                } else {
                    msgBox.className = 'error-msg';
                    msgBox.innerText = data.message || 'Reset failed.';
                    msgBox.style.display = 'block';
                }
            } catch (err) {
                msgBox.className = 'error-msg';
                msgBox.innerText = 'System connection error, please try again later.';
                msgBox.style.display = 'block';
            }
        });
    </script>
</body>
</html>