<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>User Login</title>
    <link href="login.css" rel="stylesheet">
</head>
<body>
<div id="loginModal" class="modal-overlay" style="display: none;">
    <div class="glass-card">
        <h2 class="login-title" style="color: #fff; margin-bottom: 16px;">Sign in</h2>
        <div id="modalMsg" class="error-msg"></div>
        <form id="modalLoginForm" class="login-form">
            <div class="form-group">
                <label for="modalUsername" style="color: #fff;">Username / Email</label>
                <input type="text" id="modalUsername" required autocomplete="username">
            </div>
            <div class="form-group">
                <div class="label-wrapper">
                    <label for="modalPassword" style="color: #fff;">Password</label>
                    <a href="/forgotPassword" class="forgot-link" style="color: #58a6ff;">Forgot password?</a>
                </div>
                <input type="password" id="modalPassword" required autocomplete="current-password">
            </div>
            <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <div class="signup-wrapper" style="color: #ccc; margin-top: 16px;">
            New user? <a href="/signup" style="color: #58a6ff;">Create an account</a>
        </div>
    </div>
</div>
<script>
// 掛載到 window 全域
window.openLoginModal = function(onSuccessCallback = null) {
    const modal = document.getElementById('loginModal');
    if (modal) {
        modal.style.display = 'flex';
        window._loginSuccessCallback = onSuccessCallback;
    }
};
window.closeLoginModal = function() {
    const modal = document.getElementById('loginModal');
    if (modal) {
        modal.style.display = 'none';
        document.getElementById('modalMsg').innerText = '';
        document.getElementById('modalLoginForm').reset();
    }
};
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('loginModal');
    const form = document.getElementById('modalLoginForm');
    const glassCard = modal?.querySelector('.glass-card');
    if (modal) {
        modal.addEventListener('click', () => {
            closeLoginModal();
        });
    }
    if (glassCard) {
        glassCard.addEventListener('click', (e) => {
            e.stopPropagation();
        });
    }
    if (!form) return;
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = document.getElementById('modalMsg');
        if (msg) {
            msg.innerText = '';
            msg.className = 'error-msg';
            msg.style.display = 'none';
        }
        const username = document.getElementById('modalUsername').value.trim();
        const password = document.getElementById('modalPassword').value;

        try {
            const res = await fetch('/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                closeLoginModal();
                if (typeof window._loginSuccessCallback === 'function') {
                    window._loginSuccessCallback(data.user);
                } else {
                    window.location.reload();
                }
            } else if (res.status === 400 || res.status === 401) {
                if (msg) {
                    msg.className = 'error-msg';
                    msg.innerText = data.message || 'Invalid username or password.';
                    msg.style.display = 'block';
                }
            } else if (res.status >= 500) {
                if (msg) {
                    msg.className = 'error-msg';
                    msg.innerText = 'Server error (500), please try again later.';
                    msg.style.display = 'block';
                }
            } else {
                if (msg) {
                    msg.className = 'error-msg';
                    msg.innerText = data.message || 'Login failed.';
                    msg.style.display = 'block';
                }
            }
        } catch (err) {
            if (msg) {
                msg.className = 'error-msg';
                msg.innerText = 'System connection error, please try again.';
                msg.style.display = 'block';
            }
        }
    });
});
</script>