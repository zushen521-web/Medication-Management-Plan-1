<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <link rel="stylesheet" href="/login.css">
</head>
<body>
    <div class="login-container">
        <div class="logo-placeholder"></div>
        <h1 class="login-title">Change Password</h1>
        <div id="msgBox"></div>
        <form id="passwordForm" class="login-form">
            <div class="form-group">
                <label for="password">Current Password</label>
                <input type="password" id="password" name="password" required autocomplete="current-password">
            </div>
            <div class="form-group">
                <label for="newPassword">New Password</label>
                <input type="password" id="newPassword" name="newPassword" required autocomplete="new-password">
            </div>
            <button type="submit" class="btn-primary">Confirm</button>
        </form>
        <div class="signup-wrapper">
            <a href="/user">Back to Profile</a>
        </div>
    </div>
    <script>
        document.getElementById('passwordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msgBox = document.getElementById('msgBox');
            msgBox.innerText = '';
            msgBox.className = '';
            msgBox.style.display = 'none';
            const password = document.getElementById('password').value;
            const newPassword = document.getElementById('newPassword').value;
            try {
                const res = await fetch('/auth/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password, newPassword })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    msgBox.className = 'success-msg';
                    msgBox.innerText = 'Password changed successfully!';
                    msgBox.style.display = 'block';
                    document.getElementById('passwordForm').reset();
                    setTimeout(() => {
                        window.location.href = '/user';
                    }, 2000);
                } else {
                    msgBox.className = 'error-msg';
                    msgBox.innerText = data.message || 'Change password failed';
                    msgBox.style.display = 'block';
                }
            } catch (err) {
                msgBox.className = 'error-msg';
                msgBox.innerText = 'System connection error, please try again later.';
                msgBox.style.display = 'block';
            }
        });
    </script>
</body>
</html>